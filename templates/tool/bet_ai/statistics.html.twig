{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script>
        tailwind.config = {
            corePlugins: {
                preflight: false,
            },
            blocklist: ["navbar", "nav-item", "nav-link", "dropdown", "dropdown-toggle", "dropdown-menu", "btn", "container", "collapse", "navbar-collapse", "navbar-brand", "navbar-toggler", "sticky-top", "fixed-top", "shadow-sm"],
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "background": "#f7f9fb",
                        "secondary-fixed-dim": "#b7c8e1",
                        "primary-container": "#0066ff",
                        "error": "#ba1a1a",
                        "on-tertiary-fixed": "#002113",
                        "secondary": "#505f76",
                        "error-container": "#ffdad6",
                        "on-primary": "#ffffff",
                        "on-background": "#191c1e",
                        "surface-bright": "#f7f9fb",
                        "on-tertiary-fixed-variant": "#005236",
                        "tertiary": "#006645",
                        "outline": "#727687",
                        "tertiary-fixed": "#6ffbbe",
                        "on-primary-fixed-variant": "#003fa4",
                        "on-secondary-fixed-variant": "#38485d",
                        "tertiary-container": "#008259",
                        "outline-variant": "#c2c6d8",
                        "surface-container-low": "#f2f4f6",
                        "on-secondary-fixed": "#0b1c30",
                        "on-tertiary": "#ffffff",
                        "on-error": "#ffffff",
                        "inverse-on-surface": "#eff1f3",
                        "tertiary-fixed-dim": "#4edea3",
                        "primary-fixed": "#dae1ff",
                        "surface": "#f7f9fb",
                        "on-tertiary-container": "#e1ffec",
                        "primary": "#0050cb",
                        "secondary-container": "#d0e1fb",
                        "inverse-primary": "#b3c5ff",
                        "on-surface-variant": "#424656",
                        "surface-container": "#eceef0",
                        "primary-fixed-dim": "#b3c5ff",
                        "surface-container-lowest": "#ffffff",
                        "surface-container-highest": "#e0e3e5",
                        "secondary-fixed": "#d3e4fe",
                        "on-primary-fixed": "#001849",
                        "on-secondary-container": "#54647a",
                        "surface-variant": "#e0e3e5",
                        "on-surface": "#191c1e",
                        "on-secondary": "#ffffff",
                        "on-error-container": "#93000a",
                        "inverse-surface": "#2d3133",
                        "surface-container-high": "#e6e8ea",
                        "surface-tint": "#0054d6",
                        "on-primary-container": "#f8f7ff",
                        "surface-dim": "#d8dadc",
                        "warning": "#e6a23c",
                        "info": "#409eff",
                        "success": "#67c23a"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "lg": "24px",
                        "gutter": "24px",
                        "xl": "40px",
                        "sm": "8px",
                        "base": "4px",
                        "xs": "4px",
                        "margin": "32px",
                        "md": "16px"
                    },
                    "fontFamily": {
                        "body-md": ["Inter"],
                        "display-lg": ["Inter"],
                        "headline-lg": ["Inter"],
                        "title-md": ["Inter"],
                        "body-sm": ["Inter"],
                        "headline-lg-mobile": ["Inter"],
                        "label-caps": ["Inter"],
                        "numeric-data": ["Inter"]
                    },
                    "fontSize": {
                        "body-md": ["16px", {"lineHeight": "24px", "fontWeight": "400"}],
                        "display-lg": ["48px", {"lineHeight": "56px", "letterSpacing": "-0.02em", "fontWeight": "700"}],
                        "headline-lg": ["32px", {"lineHeight": "40px", "letterSpacing": "-0.01em", "fontWeight": "600"}],
                        "title-md": ["20px", {"lineHeight": "28px", "fontWeight": "600"}],
                        "body-sm": ["14px", {"lineHeight": "20px", "fontWeight": "400"}],
                        "headline-lg-mobile": ["24px", {"lineHeight": "32px", "fontWeight": "600"}],
                        "label-caps": ["12px", {"lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "600"}],
                        "numeric-data": ["14px", {"lineHeight": "20px", "fontWeight": "600"}]
                    }
                },
            },
        }
    </script>
    <style>
        .betai-wrapper img,
        .betai-wrapper svg,
        .betai-wrapper video,
        .betai-wrapper canvas,
        .betai-wrapper audio,
        .betai-wrapper iframe,
        .betai-wrapper embed,
        .betai-wrapper object {
            display: block;
            vertical-align: middle;
        }
        .betai-wrapper img,
        .betai-wrapper video {
            max-width: 100%;
            height: auto;
        }
        .betai-wrapper {
            background-color: #f7f9fb;
            color: #191c1e;
            min-height: calc(100vh - 120px);
        }
        .betai-wrapper * {
            box-sizing: border-box;
            border-width: 0;
            border-style: solid;
            border-color: #c2c6d8;
        }
        .navbar * {
            border-width: initial;
            border-style: initial;
            border-color: initial;
        }
        .navbar, .navbar * {
            box-sizing: border-box;
        }
        .navbar-toggler-icon {
            display: block !important;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="betai-wrapper">
        <main class="flex-grow w-full max-w-7xl mx-auto px-lg md:px-xl py-lg md:py-xl flex flex-col gap-xl">
            <section class="flex flex-col gap-base md:flex-row md:justify-between md:items-end">
                <div>
                    <h1 class="text-headline-lg-mobile md:text-headline-lg font-headline-lg-mobile md:font-headline-lg text-on-surface mb-1">Wett-Statistiken</h1>
                    <p class="text-secondary font-body-md text-body-md">Detaillierte Analyse deiner Erfolgsbilanz.</p>
                </div>
                <div class="flex items-center gap-md mt-4 md:mt-0">
                    <span class="text-label-caps font-label-caps text-secondary uppercase tracking-wider">Ab Woche:</span>
                    <form action="{{ path('app_bet_ai_statistics') }}" method="GET" class="flex items-center">
                        <select name="startGameWeekId" class="bg-surface-container border border-outline-variant text-on-surface px-lg py-sm rounded-lg font-label-caps text-label-caps focus:ring-0 focus:outline-none cursor-pointer" onchange="this.form.submit()">
                            <option value="">Alle</option>
                            {% for gw in gameWeeks %}
                                <option value="{{ gw.id }}" {% if selectedGameWeek and selectedGameWeek.id == gw.id %}selected{% endif %}>{{ gw.name }}</option>
                            {% endfor %}
                        </select>
                    </form>
                    <a href="{{ path('app_bet_ai_index') }}" class="bg-surface-container border border-outline-variant text-on-surface px-lg py-sm rounded-lg font-label-caps text-label-caps hover:bg-surface-container-high transition-colors flex items-center no-underline">
                        <span class="material-symbols-outlined text-[20px] mr-2">arrow_back</span>Dashboard
                    </a>
                </div>
            </section>

            <!-- Overall Stats Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-lg">
                <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-lg shadow-sm flex items-start gap-md">
                    <div class="bg-primary-container/10 p-sm rounded-lg text-primary"><span class="material-symbols-outlined">numbers</span></div>
                    <div class="flex flex-col"><span class="text-label-caps text-secondary uppercase tracking-wider">Gesamtzahl Wetten</span><span class="text-title-md text-on-surface">{{ stats.totalBets }}</span></div>
                </div>
                <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-lg shadow-sm flex items-start gap-md">
                    <div class="bg-success/10 p-sm rounded-lg text-success"><span class="material-symbols-outlined">percent</span></div>
                    <div class="flex flex-col"><span class="text-label-caps text-secondary uppercase tracking-wider">Gewinnrate</span><span class="text-title-md {{ stats.winRate >= 0.5 ? 'text-success' : 'text-error' }}">{{ (stats.winRate * 100)|number_format(2) }}%</span></div>
                </div>
                <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-lg shadow-sm flex items-start gap-md">
                    <div class="bg-info/10 p-sm rounded-lg text-info"><span class="material-symbols-outlined">trending_up</span></div>
                    <div class="flex flex-col"><span class="text-label-caps text-secondary uppercase tracking-wider">Gesamtbilanz</span><span class="text-title-md {{ stats.totalProfitLoss >= 0 ? 'text-success' : 'text-error' }}">{{ stats.totalProfitLoss|number_format(2) }}</span></div>
                </div>
                <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-lg shadow-sm flex items-start gap-md">
                    <div class="bg-secondary/10 p-sm rounded-lg text-secondary"><span class="material-symbols-outlined">psychology</span></div>
                    <div class="flex flex-col"><span class="text-label-caps text-secondary uppercase tracking-wider">Ø Confidence</span><span class="text-title-md text-on-surface">{{ stats.avgConfidenceScore|number_format(2) }}</span></div>
                </div>
            </div>

            <!-- Detailed Stats Table -->
            <section class="bg-surface-container-lowest border border-outline-variant rounded-xl p-lg shadow-sm">
                <h2 class="title-md mb-lg">Analyse pro Wett-Typ</h2>
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="border-b border-outline-variant text-label-caps text-secondary">
                                <th class="p-md">Typ</th>
                                <th class="p-md">Wetten</th>
                                <th class="p-md">Gewinnrate</th>
                                <th class="p-md">Bilanz</th>
                                <th class="p-md">Ø Confidence</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for t in stats.statsPerType %}
                                <tr class="border-b border-surface-variant hover:bg-surface-container-low transition-colors">
                                    <td class="p-md">
                                        <div class="inline-flex items-center gap-xs {{ t.betType.getContainerClass() }} px-sm py-1 rounded-lg">
                                            <span class="material-symbols-outlined text-[14px] {{ t.betType.getTextColorClass() }}">{{ t.betType.getIcon() }}</span>
                                            <span class="text-[12px] font-bold uppercase tracking-wider text-black">{{ t.betType.getLabel() }}</span>
                                        </div>
                                    </td>
                                    <td class="p-md text-on-surface">{{ t.statistics.totalBets }}</td>
                                    <td class="p-md font-bold {{ t.statistics.winRate >= 0.5 ? 'text-success' : 'text-error' }}">{{ (t.statistics.winRate * 100)|number_format(2) }}%</td>
                                    <td class="p-md font-bold {{ t.statistics.totalProfitLoss >= 0 ? 'text-success' : 'text-error' }}">{{ t.statistics.totalProfitLoss|number_format(2) }}</td>
                                    <td class="p-md text-on-surface">{{ t.statistics.avgConfidenceScore|number_format(2) }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </section>
            <!-- Detailed Stats Table: Market Types -->
            <section class="bg-surface-container-lowest border border-outline-variant rounded-xl p-lg shadow-sm">
                <h2 class="title-md mb-lg">Analyse pro Markt-Typ</h2>
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="border-b border-outline-variant text-label-caps text-secondary">
                                <th class="p-md">Markt-Typ</th>
                                <th class="p-md">Wetten</th>
                                <th class="p-md">Gewinnrate</th>
                                <th class="p-md">Bilanz</th>
                                <th class="p-md">Ø Confidence</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for m in stats.statsPerMarketType %}
                                <tr class="border-b border-surface-variant hover:bg-surface-container-low transition-colors">
                                    <td class="p-md">
                                        <div class="inline-flex items-center gap-xs {{ m.marketType.getContainerClass() }} px-sm py-1 rounded-lg">
                                            <span class="material-symbols-outlined text-[14px] {{ m.marketType.getTextColorClass() }}">{{ m.marketType.getIcon() }}</span>
                                            <span class="text-[12px] font-bold uppercase tracking-wider text-black">{{ m.marketType.getLabel() }}</span>
                                        </div>
                                    </td>
                                    <td class="p-md text-on-surface">{{ m.statistics.totalBets }}</td>
                                    <td class="p-md font-bold {{ m.statistics.winRate >= 0.5 ? 'text-success' : 'text-error' }}">{{ (m.statistics.winRate * 100)|number_format(2) }}%</td>
                                    <td class="p-md font-bold {{ m.statistics.totalProfitLoss >= 0 ? 'text-success' : 'text-error' }}">{{ m.statistics.totalProfitLoss|number_format(2) }}</td>
                                    <td class="p-md text-on-surface">{{ m.statistics.avgConfidenceScore|number_format(2) }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </section>
        </main>
    </div>
{% endblock %}
