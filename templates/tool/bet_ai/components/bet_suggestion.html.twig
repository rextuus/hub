<div class="bg-surface-container-lowest border {{ suggestion.isSelected() ? (suggestion.betType.value == 'COMBI' ? 'border-primary' : 'border-outline-variant') : 'border-outline-variant/30 opacity-50' }} rounded-2xl overflow-hidden shadow-md h-full flex flex-col transition-all">
    <div class="bg-surface-container-low px-md sm:px-lg py-sm sm:py-md flex justify-between items-center border-b border-outline-variant">
        <div class="flex items-center gap-xs sm:gap-sm">
            <form method="post" action="{{ path('app_bet_ai_gameweek_toggle_selection', {id: suggestion.gameWeek.id, suggestionId: suggestion.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('bet_ai_gameweek') }}">
                <button type="submit" class="flex items-center justify-center bg-transparent border-none cursor-pointer p-0 text-secondary hover:text-primary transition-colors">
                    <span class="material-symbols-outlined text-[20px]">
                        {{ suggestion.isSelected() ? 'check_box' : 'check_box_outline_blank' }}
                    </span>
                </button>
            </form>
            {% if index %}
                <span class="bg-secondary/10 text-secondary w-5 h-5 sm:w-6 sm:h-6 flex items-center justify-center rounded-full text-[9px] sm:text-[10px] font-bold">#{{ index }}</span>
            {% endif %}
            <div class="flex items-center gap-xs {{ suggestion.betType.getContainerClass() }} px-xs sm:px-sm py-0.5 sm:py-xs rounded-full">
                <span class="material-symbols-outlined text-[14px] sm:text-[16px] {{ suggestion.betType.getTextColorClass() }}">{{ suggestion.betType.getIcon() }}</span>
                <span class="text-[9px] sm:text-[10px] font-label-caps font-bold tracking-wider uppercase text-black">{{ suggestion.betType.getLabel() }}</span>
            </div>
        </div>
        <div class="flex gap-sm sm:gap-lg">
            <div class="flex flex-col items-end">
                <span class="text-[9px] sm:text-[10px] text-secondary uppercase font-label-caps">AI-Quote</span>
                <span class="text-[12px] sm:text-body-sm font-bold text-on-surface">{{ suggestion.totalOdds|number_format(2) }}</span>
            </div>
            {% if suggestion.actualOdds %}
                <div class="flex flex-col items-end">
                    <span class="text-[9px] sm:text-[10px] text-success uppercase font-label-caps">Reale Quote</span>
                    <span class="text-[12px] sm:text-body-sm font-bold text-success">{{ suggestion.actualOdds|number_format(2) }}</span>
                </div>
            {% endif %}
        </div>
    </div>

    <div class="p-md sm:p-lg flex-grow">
        <div class="flex items-start justify-between gap-md mb-xs">
            <h5 class="text-[18px] sm:text-title-md font-title-md text-primary leading-tight">{{ suggestion.market }}</h5>
            <div class="flex items-center gap-xs {{ suggestion.marketType.getContainerClass() }} px-sm py-1 rounded-lg shrink-0">
                <span class="material-symbols-outlined text-[12px] sm:text-[14px] {{ suggestion.marketType.getTextColorClass() }}">{{ suggestion.marketType.getIcon() }}</span>
                <span class="text-[8px] sm:text-[9px] font-bold uppercase tracking-wider text-black">{{ suggestion.marketType.getLabel() }}</span>
            </div>
        </div>
        <h6 class="text-[14px] sm:text-body-md font-medium text-on-surface mb-md">{{ suggestion.prediction }}</h6>
        <p class="text-[12px] sm:text-body-sm text-secondary hover:text-on-surface transition-all cursor-help" title="{{ suggestion.aiReasoning }}">{{ suggestion.aiReasoning }}</p>

        <div class="mt-md sm:mt-lg">
            <h6 class="text-[10px] sm:text-label-caps font-label-caps text-secondary uppercase tracking-widest border-b border-outline-variant pb-xs mb-md">Spiele</h6>
            <div class="flex flex-col gap-md">
                {% for item in this.matchItems %}
                    {% if item.match %}
                        <div class="flex flex-col gap-xs">
                            <div class="flex items-center justify-between gap-sm">
                                <!-- Home Team -->
                                <div class="flex items-center gap-xs sm:gap-sm flex-1 justify-end overflow-hidden">
                                    {% if item.match.homeTeam %}
                                        <span class="text-[12px] sm:text-body-sm font-bold text-on-surface text-right truncate">{{ item.match.homeTeam.name }}</span>
                                        {% if item.match.homeTeam.profileImgUrl %}
                                            <img src="{{ item.match.homeTeam.profileImgUrl }}" alt="{{ item.match.homeTeam.name }}" class="w-5 h-5 sm:w-6 sm:h-6 rounded-full object-cover border border-outline-variant shrink-0">
                                        {% endif %}
                                    {% else %}
                                        <span class="text-[12px] sm:text-body-sm font-bold text-on-surface text-right truncate">{{ item.match.rawHomeTeamName }}</span>
                                    {% endif %}
                                </div>

                                <span class="text-[10px] sm:text-label-sm font-light text-secondary">vs</span>

                                <!-- Away Team -->
                                <div class="flex items-center gap-xs sm:gap-sm flex-1 overflow-hidden">
                                    {% if item.match.awayTeam %}
                                        {% if item.match.awayTeam.profileImgUrl %}
                                            <img src="{{ item.match.awayTeam.profileImgUrl }}" alt="{{ item.match.awayTeam.name }}" class="w-5 h-5 sm:w-6 sm:h-6 rounded-full object-cover border border-outline-variant shrink-0">
                                        {% endif %}
                                        <span class="text-[12px] sm:text-body-sm font-bold text-on-surface truncate">{{ item.match.awayTeam.name }}</span>
                                    {% else %}
                                        <span class="text-[12px] sm:text-body-sm font-bold text-on-surface truncate">{{ item.match.rawAwayTeamName }}</span>
                                    {% endif %}
                                </div>
                            </div>
                            <div class="flex justify-center items-center gap-sm">
                                <span class="text-[9px] sm:text-[10px] text-secondary font-medium">{{ item.match.matchDate|date('d.m. H:i') }}</span>
                                {% if item.match.homeTeam is null or item.match.awayTeam is null %}
                                    <a href="{{ path('app_bet_ai_match_fix', {id: item.match.id}) }}" class="text-warning hover:text-primary transition-colors" title="Teams zuordnen">
                                        <span class="material-symbols-outlined text-[14px] sm:text-[16px]">magic_button</span>
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                    {% endif %}
                {% else %}
                    <p class="text-body-sm text-secondary italic">Keine Spiele zugeordnet.</p>
                {% endfor %}
            </div>
        </div>
    </div>

    <div class="bg-surface-container-low p-md sm:p-lg border-t border-outline-variant mt-auto">
        <div class="flex justify-between items-center mb-md sm:mb-lg">
            <div class="flex flex-col">
                <span class="text-[9px] sm:text-[10px] text-secondary uppercase font-label-caps">Einsatz</span>
                <span class="text-[16px] sm:text-title-sm font-title-sm text-on-surface">{{ suggestion.suggestedStake|number_format(2) }} €</span>
            </div>
            <div class="flex flex-col items-end">
                <span class="text-[9px] sm:text-[10px] text-secondary uppercase font-label-caps">Confidence</span>
                <div class="flex items-center gap-xs">
                    <span class="text-[16px] sm:text-title-sm font-title-sm text-on-surface">{{ suggestion.confidenceScore }}</span>
                    <span class="text-[12px] sm:text-body-sm text-secondary">/10</span>
                </div>
            </div>
        </div>

        {% set placedBet = this.getPlacedBet() %}
        {% if not suggestion.isPlaced %}
            <div class="flex flex-col gap-md">
                <form method="post" action="{{ path('app_bet_ai_gameweek_place_suggestion', {id: suggestion.gameWeek.id, suggestionId: suggestion.id}) }}" class="flex flex-col gap-sm">
                    <input type="hidden" name="_token" value="{{ csrf_token('bet_ai_gameweek') }}">
                    <div class="flex gap-sm">
                        <input type="number" step="0.01" name="actualOdds" class="bg-surface-bright border border-outline-variant rounded-lg px-md py-xs text-body-sm w-full focus:outline-primary" placeholder="Reale Quote" value="{{ suggestion.actualOdds }}">
                        <button type="submit" class="bg-primary text-on-primary px-lg py-xs rounded-lg font-label-caps text-label-caps hover:bg-primary-container hover:text-on-primary-container transition-all border-none cursor-pointer whitespace-nowrap">
                            Platzieren
                        </button>
                    </div>
                </form>

                <form method="post" action="{{ path('app_bet_ai_gameweek_update_actual_odds', {id: suggestion.gameWeek.id, suggestionId: suggestion.id}) }}" class="flex gap-sm">
                    <input type="hidden" name="_token" value="{{ csrf_token('bet_ai_gameweek') }}">
                    <input type="number" step="0.01" name="actualOdds" class="bg-surface-bright border border-outline-variant rounded-lg px-md py-xs text-body-sm w-full focus:outline-primary" placeholder="Korrigierte Quote" value="{{ suggestion.actualOdds }}">
                    <button type="submit" class="border border-outline-variant text-secondary px-lg py-xs rounded-lg font-label-caps text-label-caps hover:bg-surface-container-highest transition-all bg-transparent cursor-pointer">
                        Save
                    </button>
                </form>

                {% if not suggestion.isPlaced %}
                    {% set diff = (suggestion.actualOdds - suggestion.totalOdds)|abs %}
                    <form method="post" action="{{ path('app_bet_ai_gameweek_replace_suggestion', {id: suggestion.gameWeek.id, suggestionId: suggestion.id}) }}" class="mt-xs">
                        <input type="hidden" name="_token" value="{{ csrf_token('bet_ai_gameweek') }}">
                        <input type="hidden" name="reason" value="Manuelle Anforderung eines Austauschs.">
                        <button type="submit" class="w-full border {{ diff > 0.5 ? 'border-warning/50 text-warning hover:bg-warning/10' : 'border-outline-variant text-secondary hover:bg-surface-container-highest' }} px-lg py-xs rounded-lg font-label-caps text-label-caps transition-all bg-transparent cursor-pointer flex items-center justify-center gap-xs">
                            <span class="material-symbols-outlined text-[18px]">cached</span>
                            Wette austauschen
                        </button>
                    </form>
                {% endif %}
            </div>
        {% else %}
            {% if placedBet %}
                <div class="bg-surface-container-high rounded-xl p-md border border-outline-variant">
                    <div class="grid grid-cols-2 gap-md items-center">
                        <div class="flex flex-col">
                            <span class="text-[10px] text-secondary uppercase font-label-caps">Status</span>
                            <span class="text-body-sm font-bold {{ placedBet.status == 'WON' ? 'text-success' : (placedBet.status == 'LOST' ? 'text-error' : 'text-on-surface') }}">{{ placedBet.status }}</span>
                        </div>
                        <div class="flex flex-col items-end">
                            <span class="text-[10px] text-secondary uppercase font-label-caps">Quote</span>
                            <span class="text-body-sm font-bold text-on-surface">{{ placedBet.actualOdds|number_format(2) }}</span>
                        </div>
                    </div>

                    {% if placedBet.status == 'OPEN' %}
                        <form method="post" action="{{ path('app_bet_ai_gameweek_finalize_bet', {id: suggestion.gameWeek.id, placedBetId: placedBet.id}) }}" class="mt-md pt-md border-t border-outline-variant flex gap-sm">
                            <input type="hidden" name="_token" value="{{ csrf_token('bet_ai_gameweek') }}">
                            <input type="number" step="0.01" name="payout" class="bg-surface-bright border border-outline-variant rounded-lg px-md py-xs text-body-sm w-full focus:outline-primary" placeholder="Auszahlung" required>
                            <button type="submit" class="bg-success text-on-success px-lg py-xs rounded-lg font-label-caps text-label-caps hover:opacity-90 transition-all border-none cursor-pointer">
                                OK
                            </button>
                        </form>
                    {% else %}
                        <div class="mt-md pt-md border-t border-outline-variant flex justify-between items-center">
                            <span class="text-[10px] text-secondary uppercase font-label-caps">Auszahlung</span>
                            <span class="text-body-md font-bold text-on-surface">{{ placedBet.actualPayout|number_format(2) }} €</span>
                        </div>
                    {% endif %}
                </div>
            {% endif %}
        {% endif %}
    </div>
</div>
