{% extends 'base.html.twig' %}

{% block title %}Einstellungen - BetAI{% endblock %}

{% block body %}
    <style>
        .betai-wrapper {
            --surface-lowest: #0b0d0e;
            --surface-low: #121416;
            --surface: #1a1c1e;
            --surface-high: #242628;
            --surface-highest: #2e3032;
            --on-surface: #e2e2e6;
            --on-surface-variant: #c4c6cf;
            --outline: #8e9099;
            --outline-variant: #44474e;
            --primary: #d0e4ff;
            --on-primary: #003258;
            --secondary: #bbc7db;
            --on-secondary: #253140;
            --info: #c1e8fb;
            --warning: #fae287;
            --error: #ffb4ab;
        }

        .betai-wrapper {
            background-color: var(--surface-low);
            color: var(--on-surface);
            min-height: 100vh;
        }
    </style>

    <div class="betai-wrapper font-sans antialiased text-on-surface p-lg">
        <div class="max-w-4xl mx-auto">
            {# Header #}
            <div class="flex items-center justify-between mb-xl">
                <div class="flex items-center gap-md">
                    <a href="{{ path('app_bet_ai_index') }}" class="w-10 h-10 flex items-center justify-center rounded-xl bg-surface-high text-on-surface-variant hover:text-primary transition-colors no-underline">
                        <span class="material-symbols-outlined">arrow_back</span>
                    </a>
                    <div>
                        <h1 class="text-display-sm font-bold m-0">Einstellungen</h1>
                        <p class="text-body-md text-on-surface-variant m-0">Konfiguriere dein BetAI Tool</p>
                    </div>
                </div>
            </div>

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="mb-lg p-md rounded-xl {% if label == 'success' %}bg-primary/10 text-primary border border-primary/20{% else %}bg-error/10 text-error border border-error/20{% endif %}">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            <div class="grid gap-xl">
                <div class="bg-surface rounded-2xl border border-outline-variant overflow-hidden">
                    <div class="p-lg border-b border-outline-variant bg-surface-bright/5">
                        <div class="flex items-center gap-sm mb-xs">
                            <span class="material-symbols-outlined text-primary">psychology</span>
                            <h2 class="text-title-lg font-bold m-0">KI-Modell</h2>
                        </div>
                        <p class="text-body-sm text-on-surface-variant m-0">Wähle das Google Gemini Modell, das für die Analyse und Wett-Generierung verwendet werden soll.</p>
                    </div>

                    <div class="p-lg">
                        <form method="post" class="space-y-lg">
                            <div class="grid gap-md">
                                {% for model in models %}
                                    <label class="relative flex items-start p-md rounded-xl border-2 transition-all cursor-pointer hover:bg-surface-high {% if selectedModel == model.name %}border-primary bg-primary/5{% else %}border-outline-variant bg-surface-low{% endif %}">
                                        <input type="radio" name="gemini_model" value="{{ model.name }}" class="sr-only" {% if selectedModel == model.name %}checked{% endif %}>
                                        <div class="flex-1">
                                            <div class="flex items-center justify-between mb-xs">
                                                <span class="font-bold text-title-md">{{ model.displayName }}</span>
                                                {% if selectedModel == model.name %}
                                                    <span class="material-symbols-outlined text-primary">check_circle</span>
                                                {% endif %}
                                            </div>
                                            <p class="text-body-sm text-on-surface-variant mb-xs">{{ model.description }}</p>
                                            <code class="text-[10px] px-sm py-xs bg-surface-highest rounded text-outline">{{ model.name }}</code>
                                        </div>
                                    </label>
                                {% else %}
                                    <div class="p-lg text-center text-on-surface-variant bg-surface-low rounded-xl border border-dashed border-outline-variant">
                                        <span class="material-symbols-outlined text-display-md mb-sm">error</span>
                                        <p>Keine unterstützten Modelle gefunden oder API-Fehler.</p>
                                    </div>
                                {% endfor %}
                            </div>

                            <div class="flex justify-end pt-md">
                                <button type="submit" class="bg-primary text-on-primary px-xl py-md rounded-xl font-bold hover:opacity-90 transition-all flex items-center gap-sm border-none cursor-pointer">
                                    <span class="material-symbols-outlined">save</span>
                                    Einstellungen speichern
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="bg-surface-low rounded-2xl border border-outline-variant p-lg flex items-center gap-md">
                    <div class="w-12 h-12 rounded-xl bg-info/10 text-info flex items-center justify-center">
                        <span class="material-symbols-outlined">info</span>
                    </div>
                    <div>
                        <h3 class="text-title-md font-bold m-0">Hinweis</h3>
                        <p class="text-body-sm text-on-surface-variant m-0">Die Liste der Modelle wird live von der Google Gemini API abgerufen. Es werden nur Modelle angezeigt, die Textgenerierung unterstützen.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
