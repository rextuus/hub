{% extends 'base.html.twig' %}

{% block title %}BetAI - Dashboard{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script>
        tailwind.config = {
            corePlugins: {
                preflight: false,
            },
            blocklist: ["navbar", "nav-item", "nav-link", "dropdown", "dropdown-toggle", "dropdown-menu", "btn", "container", "collapse", "navbar-collapse", "navbar-brand", "navbar-toggler", "sticky-top", "fixed-top", "shadow-sm"],
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "background": "#f7f9fb",
                        "secondary-fixed-dim": "#b7c8e1",
                        "primary-container": "#0066ff",
                        "error": "#ba1a1a",
                        "on-tertiary-fixed": "#002113",
                        "secondary": "#505f76",
                        "error-container": "#ffdad6",
                        "on-primary": "#ffffff",
                        "on-background": "#191c1e",
                        "surface-bright": "#f7f9fb",
                        "on-tertiary-fixed-variant": "#005236",
                        "tertiary": "#006645",
                        "outline": "#727687",
                        "tertiary-fixed": "#6ffbbe",
                        "on-primary-fixed-variant": "#003fa4",
                        "on-secondary-fixed-variant": "#38485d",
                        "tertiary-container": "#008259",
                        "outline-variant": "#c2c6d8",
                        "surface-container-low": "#f2f4f6",
                        "on-secondary-fixed": "#0b1c30",
                        "on-tertiary": "#ffffff",
                        "on-error": "#ffffff",
                        "inverse-on-surface": "#eff1f3",
                        "tertiary-fixed-dim": "#4edea3",
                        "primary-fixed": "#dae1ff",
                        "surface": "#f7f9fb",
                        "on-tertiary-container": "#e1ffec",
                        "primary": "#0050cb",
                        "secondary-container": "#d0e1fb",
                        "inverse-primary": "#b3c5ff",
                        "on-surface-variant": "#424656",
                        "surface-container": "#eceef0",
                        "primary-fixed-dim": "#b3c5ff",
                        "surface-container-lowest": "#ffffff",
                        "surface-container-highest": "#e0e3e5",
                        "secondary-fixed": "#d3e4fe",
                        "on-primary-fixed": "#001849",
                        "on-secondary-container": "#54647a",
                        "surface-variant": "#e0e3e5",
                        "on-surface": "#191c1e",
                        "on-secondary": "#ffffff",
                        "on-error-container": "#93000a",
                        "inverse-surface": "#2d3133",
                        "surface-container-high": "#e6e8ea",
                        "surface-tint": "#0054d6",
                        "on-primary-container": "#f8f7ff",
                        "surface-dim": "#d8dadc",
                        "warning": "#e6a23c",
                        "info": "#409eff",
                        "success": "#67c23a"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "lg": "24px",
                        "gutter": "24px",
                        "xl": "40px",
                        "sm": "8px",
                        "base": "4px",
                        "xs": "4px",
                        "margin": "32px",
                        "md": "16px"
                    },
                    "fontFamily": {
                        "body-md": ["Inter"],
                        "display-lg": ["Inter"],
                        "headline-lg": ["Inter"],
                        "title-md": ["Inter"],
                        "body-sm": ["Inter"],
                        "headline-lg-mobile": ["Inter"],
                        "label-caps": ["Inter"],
                        "numeric-data": ["Inter"]
                    },
                    "fontSize": {
                        "body-md": ["16px", {"lineHeight": "24px", "fontWeight": "400"}],
                        "display-lg": ["48px", {"lineHeight": "56px", "letterSpacing": "-0.02em", "fontWeight": "700"}],
                        "headline-lg": ["32px", {"lineHeight": "40px", "letterSpacing": "-0.01em", "fontWeight": "600"}],
                        "title-md": ["20px", {"lineHeight": "28px", "fontWeight": "600"}],
                        "body-sm": ["14px", {"lineHeight": "20px", "fontWeight": "400"}],
                        "headline-lg-mobile": ["24px", {"lineHeight": "32px", "fontWeight": "600"}],
                        "label-caps": ["12px", {"lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "600"}],
                        "numeric-data": ["14px", {"lineHeight": "20px", "fontWeight": "600"}]
                    }
                },
            },
        }
    </script>
    <style>
        .betai-wrapper img,
        .betai-wrapper svg,
        .betai-wrapper video,
        .betai-wrapper canvas,
        .betai-wrapper audio,
        .betai-wrapper iframe,
        .betai-wrapper embed,
        .betai-wrapper object {
            display: block;
            vertical-align: middle;
        }
        .betai-wrapper img,
        .betai-wrapper video {
            max-width: 100%;
            height: auto;
        }
        .betai-wrapper {
            background-color: #f7f9fb;
            color: #191c1e;
            min-height: calc(100vh - 120px);
        }
        .betai-wrapper * {
            box-sizing: border-box;
            border-width: 0;
            border-style: solid;
            border-color: #c2c6d8; /* outline-variant */
        }
        /* Reset for header elements to ensure they don't inherit the wrapper's border reset */
        .navbar * {
            border-width: initial;
            border-style: initial;
            border-color: initial;
        }
        .navbar, .navbar * {
            box-sizing: border-box; /* Bootstrap uses border-box too, but let's be safe */
        }
        .navbar-toggler-icon {
            display: block !important;
        }
    </style>
{% endblock %}

{% block body %}
    <div {{ stimulus_controller('symfony/ux-live-component:live') }} data-component-name="bet_ai_dashboard">
        {{ component('bet_ai_dashboard') }}
    </div>
{% endblock %}
