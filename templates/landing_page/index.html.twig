{% extends 'base.html.twig' %}

{% set show_header = false %}
{% set show_footer = false %}

{% block title %}WH-Company{% endblock %}
{% block meta %}
    <meta name="description" content="WH-Company – Debes, Nimbus, Secret Santa und weitere Projekte.">
    <link rel="canonical" href="https://{{ app.request.host|replace({'www.': ''}) }}/">
{% endblock %}
{% block body_class %}wh-page{% endblock %}

{% block body %}
<main class="wh-landing" data-controller="wh-gallery">
    <aside class="wh-sidebar">
        {# Bewusst unauffällig: Die Anmeldung erreicht man nur über das Logo. #}
        <a class="wh-sidebar__logo" href="{{ app.user ? path('app_projects') : path('app_login') }}" aria-label="WH-Company">
            <img src="{{ asset('images/brand/logo.svg') }}" alt="WH-Company – Software Architecture in Perfection" width="350" height="236">
        </a>

        <nav class="wh-sidebar__nav" aria-label="Projekte">
            <ul>
                {% for project in featured %}
                    <li>
                        <a href="{{ project.route ? path(project.route) : project.url }}"
                           data-wh-gallery-target="link"
                           data-wh-gallery-index-param="{{ loop.index0 }}"
                           data-action="mouseenter->wh-gallery#activate focus->wh-gallery#activate">{{ project.name }}</a>
                    </li>
                {% endfor %}
            </ul>
        </nav>

        <a class="wh-sidebar__all" href="{{ path('app_projects') }}">
            <span>Alle Projekte</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
    </aside>

    <section class="wh-gallery" aria-label="Unsere Projekte">
        {% for project in featured %}
            {% set href = project.route ? path(project.route) : project.url %}
            <a class="wh-tile{{ loop.first ? ' is-active' }}" href="{{ href }}"
               data-wh-gallery-target="tile"
               data-wh-gallery-index-param="{{ loop.index0 }}"
               data-action="mouseenter->wh-gallery#activate focus->wh-gallery#activate">
                {% if project.video %}
                    <video class="wh-tile__media" muted loop playsinline preload="metadata"
                           {% if project.image %}poster="{{ media_url(project.image, 'tile', 960) }}"{% endif %}
                           data-wh-gallery-target="video"
                           style="object-position: {{ project.imagePosition ?: '50% 50%' }}">
                        <source src="{{ media_original(project.video) }}" type="video/mp4">
                    </video>
                {% elseif project.image %}
                    <img class="wh-tile__media" alt=""
                         src="{{ media_url(project.image, 'tile', 960) }}"
                         srcset="{{ media_srcset(project.image, 'tile') }}"
                         sizes="(min-width: 75em) 45vw, 100vw"
                         {% if not loop.first %}loading="lazy"{% endif %}
                         style="object-position: {{ project.imagePosition ?: '50% 50%' }}">
                {% endif %}
                <span class="wh-tile__text">
                    <span class="wh-tile__title">{{ project.name }}</span>
                    <span class="wh-tile__desc">{{ project.description }}</span>
                </span>
            </a>
        {% endfor %}
    </section>
</main>
{% endblock %}
