# Hub – Caddy vor PHP-FPM. Nur HTTP (SERVER_NAME=":80"): HTTPS macht der Caddy auf dem VPS, der über
# WireGuard hierher weiterleitet (docs/deployment.md).
{
	admin off
	servers {
		# Von diesen Adressen (dem Reverse-Proxy) werden X-Forwarded-For/-Proto übernommen: echte Gast-IP
		# und „kam per HTTPS“. Von allen anderen setzt Caddy die Werte selbst (nicht fälschbar).
		trusted_proxies static {$REVERSE_PROXY_IPS:private_ranges}
		client_ip_headers X-Forwarded-For
	}
}

{$SERVER_NAME::80} {
	root * /srv/app/public
	encode zstd gzip

	request_body {
		max_size 9MB
	}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}

	# Kompilierte Assets tragen einen Hash im Namen (Team-Logos nicht).
	@hashed {
		path_regexp ^/assets/.+-[A-Za-z0-9_-]{7,}\.\w+$
		not path /assets/bet_ai/*
	}
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	php_fastcgi app:9000
	file_server
}
