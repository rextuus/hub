# Hub – Caddy vor PHP-FPM. Nur HTTP (SERVER_NAME=":80"): HTTPS macht der Caddy auf dem VPS, der über
# WireGuard hierher weiterleitet (docs/deployment.md).
{
	admin off
	servers {
		# Von diesen Adressen (dem Reverse-Proxy) werden X-Forwarded-For/-Proto übernommen: echte Gast-IP
		# und „kam per HTTPS“. Von allen anderen setzt Caddy die Werte selbst (nicht fälschbar).
		trusted_proxies static {$REVERSE_PROXY_IPS:private_ranges}
		client_ip_headers X-Forwarded-For
	}
}

{$SERVER_NAME::80} {
	root * /srv/app/public
	encode zstd gzip

	# Uploads in EasyAdmin (mehrere Fotos auf einmal): PHP nimmt bis 100 MB an (docker/php/conf.d/app.ini).
	request_body {
		max_size 104MB
	}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}

	# Kompilierte Assets tragen einen Hash im Namen.
	@hashed path_regexp ^/assets/.+-[A-Za-z0-9_-]{7,}\.\w+$
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# Bilder aus dem Medienordner: signierte URLs (src/Media/MediaUrlGenerator.php) → imgproxy, das den Ordner nur
	# lesend kennt. Ohne gültige Signatur antwortet imgproxy 403. Die URL ändert sich mit jeder Größe/Datei, also
	# lange cachen. Originale (/media/…) liefert PHP (src/Media/Controller/MediaController.php).
	handle_path /img/* {
		reverse_proxy imgproxy:8080 {
			header_down -Server
			header_down Cache-Control "public, max-age=31536000, immutable"
		}
	}

	handle {
		php_fastcgi app:9000
		file_server
	}
}
