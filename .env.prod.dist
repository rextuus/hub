# Hub – Produktionswerte für compose.prod.yaml. Vorlage ohne echte Werte, nie echte Werte hier eintragen.
#
# Ergebnis ist immer .env.prod.local im Stack-Ordner:
#  - Komodo (Standard): Werte im Stack unter „Environment“ (siehe deploy/komodo/hub.toml). Mit [SECRET]
#    markierte Werte als Komodo-Variable mit Häkchen „Secret“ anlegen (Settings → Variables, Name hinter
#    „Komodo:“) und im Environment als [[NAME]] einsetzen. Komodo schreibt .env.prod.local bei jedem Deploy neu –
#    die Datei auf dem Server also nicht von Hand ändern, sondern in Komodo.
#  - Probelauf auf dem eigenen Rechner: diese Datei kopieren, Werte ausfüllen, VOLUME_PREFIX setzen
#    (docs/deployment.md, „Generalprobe“).
# .env.prod.local nie ins Repository. Die Secrets im Passwortmanager aufbewahren.

# --- Adresse ---------------------------------------------------------------------------------------------
# Öffentliche Adresse mit https://. Komodo: fest in deploy/komodo/hub.toml.
DEFAULT_URI=https://wh-company.example

# --- Secrets ---------------------------------------------------------------------------------------------
# [SECRET] Symfony-Schlüssel (Sitzungen, Remember-me-Cookies, CSRF). Beim Umzug den bisherigen Wert von
# securitas übernehmen (/var/www/hub/.env.local bzw. .env.prod.local), sonst sind alle abgemeldet.
# Neu: `openssl rand -hex 32`. Komodo: [[HUB_APP_SECRET]]
APP_SECRET=
# [SECRET] Passwort des Datenbank-Benutzers. Gilt nur beim allerersten Start (leeres Volume); danach muss es zum
# bestehenden Volume passen. Neu würfeln: `openssl rand -hex 24`. Komodo: [[HUB_MYSQL_PASSWORD]]
MYSQL_PASSWORD=
# [SECRET] Root-Passwort der Datenbank (auch für die Sicherungen). Wie oben. Komodo: [[HUB_MYSQL_ROOT_PASSWORD]]
MYSQL_ROOT_PASSWORD=
# [SECRET] Google-Gemini-Schlüssel für BetAI. Pflicht (der Dienst startet ohne Wert nicht); den bisherigen Wert
# von securitas übernehmen. Komodo: [[HUB_GEMINI_API_KEY]]
GEMINI_API_KEY=
# [SECRET] imgproxy (Dienst imgproxy und app, signierte Bild-URLs). Je einmal `openssl rand -hex 32`.
# Nie ohne Not ändern: Alle Bild-URLs in Browser-Caches werden sonst ungültig (Bilder laden dann neu, nichts geht
# verloren). Komodo: [[HUB_IMGPROXY_KEY]] bzw. [[HUB_IMGPROXY_SALT]]
IMGPROXY_KEY=
IMGPROXY_SALT=
# [SECRET] Sentry-DSN für Fehlermeldungen (leer = aus). Komodo: [[HUB_SENTRY_DSN]]
# (ohne Sentry die Zeile im Komodo-Environment löschen statt eine leere Variable anzulegen)
SENTRY_DSN=
# [SECRET] Mailversand (kann Zugangsdaten enthalten). null://null = keine Mails; Hub verschickt derzeit nichts.
# Komodo: [[HUB_MAILER_DSN]] (anlegen mit dem Wert null://null)
MAILER_DSN=null://null

# --- Datenbank (fest, nicht ändern: gehört zum bestehenden Volume) ----------------------------------------
MYSQL_DATABASE=hub
MYSQL_USER=hub

# --- Eingang: Caddy auf dem VPS → WireGuard → hierher ------------------------------------------------------
# Der einzige Host-Port des Stacks (abyss: 8197). Komodo: fest in deploy/komodo/hub.toml.
HTTP_PORT=8197
# Nur auf dieser Adresse lauschen – die WireGuard-IP von abyss. Komodo: fest in deploy/komodo/hub.toml.
HTTP_BIND=10.0.0.2
# Von wem X-Forwarded-For/-Proto übernommen werden: die WireGuard-IP des VPS-Caddys. Komodo: fest in hub.toml.
REVERSE_PROXY_IPS=10.0.0.1

# --- Sicherungen (Dienst backup, deploy/komodo/db-backup.sh) ----------------------------------------------
# Host-Ordner für die Datenbank-Dumps. Muss existieren (einmalig: sudo install -d -m 700 /srv/hub/backups) –
# Docker legt ihn absichtlich nicht selbst an.
BACKUP_DIR=/srv/hub/backups
# So viele Dumps je Anlass (daily, pre-deploy, manuell) bleiben liegen; täglich 14 = zwei Wochen.
BACKUP_KEEP=14

# --- Nur für Probeläufe ----------------------------------------------------------------------------------
# Präfix der Volume-Namen (Standard hub → hub_database_data, hub_media_data, …). Auf dem Server NIE setzen.
# Auf dem Entwicklungsrechner PFLICHT (z. B. hubprobe), weil die Entwicklungsumgebung ebenfalls hub_* heißt.
#VOLUME_PREFIX=hubprobe
